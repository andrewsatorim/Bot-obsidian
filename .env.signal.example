# PRIVATE signal engine config — copy to .env.signal and fill in.
# Separate process, separate Telegram token. NOT shared with the main bot.
# .env.signal is gitignored and must never be committed.

# Universe to scan (read-only; the signal engine never trades these)
SIGNAL_SYMBOLS=["BTC/USDT:USDT","ETH/USDT:USDT","SOL/USDT:USDT"]
SIGNAL_SCAN_INTERVAL_SEC=30.0

# Setup / risk thresholds
SIGNAL_MIN_CONFIDENCE=0.5
SIGNAL_ACCOUNT_EQUITY=10000.0

# Coinglass v4 — powers the liquidation-heatmap and OI factors with real data.
# If left empty, those two factors are reported as "данные недоступны" and never
# counted toward setup quality (honest fallback, no fabricated confirmations).
SIGNAL_COINGLASS_API_KEY=

# PRIVATE Telegram channel — distinct token + chat from the main bot
SIGNAL_TELEGRAM_BOT_TOKEN=
SIGNAL_TELEGRAM_CHAT_ID=

SIGNAL_LOG_LEVEL=INFO
