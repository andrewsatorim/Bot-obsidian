# =============================================================================
# PRIVATE signal engine config — copy to .env.signal and fill in.
#
#   cp .env.signal.example .env.signal && chmod 600 .env.signal
#
# This is a SEPARATE process with a SEPARATE Telegram token. It is NEVER shared
# with the main bot ("mirror"): the main bot reads .env, this engine reads
# .env.signal, and the two files are injected into two different containers.
#
# .env.signal is gitignored and must NEVER be committed. Keep it chmod 600,
# owned by the user that runs the signal-engine container.
#
# Variable names are FIXED: pydantic-settings binds each var as
# SIGNAL_<FIELD_NAME>. Renaming a var (e.g. dropping the _BOT_ in the token)
# means it silently won't be picked up. Do not rename — only fill in values.
# =============================================================================

# --- Universe to scan ---------------------------------------------------------
# JSON list of symbols. Read-only: the engine scans these but NEVER trades them.
SIGNAL_SYMBOLS=["BTC/USDT:USDT","ETH/USDT:USDT","SOL/USDT:USDT"]

# How often (seconds) to rescan the whole universe. Float, must be > 0.
# Default raised to 60: a multi-timeframe scan issues several OHLCV requests per
# symbol, so a tighter interval risks hitting exchange rate limits.
SIGNAL_SCAN_INTERVAL_SEC=60.0

# --- Multi-timeframe architecture ---------------------------------------------
# ccxt-unified timeframe strings ("1h" == 60m, "1d" == D).
#
# Context layer (slow macro backdrop). The DAILY timeframe sets direction; the
# 12h only amplifies/dampens it. Cached and refreshed at most once per
# SIGNAL_CONTEXT_REFRESH_SEC — NOT re-fetched every scan.
SIGNAL_CONTEXT_TIMEFRAMES=["1d","12h"]
SIGNAL_CONTEXT_REFRESH_SEC=86400.0

# Evaluation panel: each casts a direction vote every scan. 5m is deliberately
# NOT here (it is the entry timeframe only, not a trend vote).
SIGNAL_EVAL_TIMEFRAMES=["15m","30m","1h","4h"]

# Setup timeframe: where the trade is detected (strategy runs here). Also a voter.
SIGNAL_SETUP_TIMEFRAME=15m
# Entry timeframe: short-term momentum / entry timing once a setup is found.
SIGNAL_ENTRY_TIMEFRAME=5m
# Candles fetched per timeframe.
SIGNAL_OHLCV_LIMIT=100

# --- Setup selection thresholds -----------------------------------------------
# Minimum signal strength (strategy factor) to even consider a setup. 0..1.
SIGNAL_MIN_CONFIDENCE=0.5

# Minimum overall setup QUALITY to actually send a signal. 0..1.
# Quality is now a WEIGHTED blend (see weights below): strategy signal + setup-TF
# regime + eval-TF consensus + D/12h context + entry momentum, plus the two
# Coinglass factors when available. Soft contribution — timeframe disagreement
# lowers the score but does not hard-gate. 0.5 is a reasonable starting floor.
SIGNAL_MIN_QUALITY=0.5

# --- Setup quality weights (SOFT contribution) --------------------------------
# Final quality = sum(weight_i * score_i) / sum(weight_i over AVAILABLE i).
# Coinglass factors drop out of the denominator when their data is unavailable,
# so missing data lowers the ceiling honestly (never a fabricated pass). Tune on
# live data.
SIGNAL_WEIGHT_SIGNAL=1.0
SIGNAL_WEIGHT_REGIME=1.0
SIGNAL_WEIGHT_LIQUIDITY=1.0
SIGNAL_WEIGHT_OI=1.0
SIGNAL_WEIGHT_EVAL_TF=2.0
SIGNAL_WEIGHT_CONTEXT=1.5
SIGNAL_WEIGHT_ENTRY=0.5
# Score a NEUTRAL context contributes (0..1).
SIGNAL_CONTEXT_NEUTRAL_SCORE=0.5

# --- Coinglass (v4) — OPTIONAL ------------------------------------------------
# Powers the liquidation-heatmap and open-interest factors with REAL data.
# Leave EMPTY for now — we run without it. When empty, those two factors are
# shown as "данные недоступны" and dropped from the weighted score (never a
# fabricated confirmation). The multi-timeframe factors still score the setup.
SIGNAL_COINGLASS_API_KEY=

# --- PRIVATE Telegram channel -------------------------------------------------
# Distinct bot token + chat from the main bot. Get the token from @BotFather
# and the chat id from @userinfobot or the getUpdates call (see deploy steps).
# Binding name is SIGNAL_TELEGRAM_BOT_TOKEN (with _BOT_) — do not shorten it.
SIGNAL_TELEGRAM_BOT_TOKEN=
SIGNAL_TELEGRAM_CHAT_ID=

# --- Misc ---------------------------------------------------------------------
SIGNAL_LOG_LEVEL=INFO
