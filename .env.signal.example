# =============================================================================
# PRIVATE signal engine config — copy to .env.signal and fill in.
#
#   cp .env.signal.example .env.signal && chmod 600 .env.signal
#
# This is a SEPARATE process with a SEPARATE Telegram token. It is NEVER shared
# with the main bot ("mirror"): the main bot reads .env, this engine reads
# .env.signal, and the two files are injected into two different containers.
#
# .env.signal is gitignored and must NEVER be committed. Keep it chmod 600,
# owned by the user that runs the signal-engine container.
#
# Variable names are FIXED: pydantic-settings binds each var as
# SIGNAL_<FIELD_NAME>. Renaming a var (e.g. dropping the _BOT_ in the token)
# means it silently won't be picked up. Do not rename — only fill in values.
# =============================================================================

# --- Universe to scan ---------------------------------------------------------
# JSON list of symbols. Read-only: the engine scans these but NEVER trades them.
SIGNAL_SYMBOLS=["BTC/USDT:USDT","ETH/USDT:USDT","SOL/USDT:USDT"]

# How often (seconds) to rescan the whole universe. Float, must be > 0.
SIGNAL_SCAN_INTERVAL_SEC=30.0

# --- Setup selection thresholds -----------------------------------------------
# Minimum signal strength (factor a) to even consider a setup. 0..1.
SIGNAL_MIN_CONFIDENCE=0.5

# Minimum overall setup QUALITY to actually send a signal. 0..1.
# NOTE: without a Coinglass key the liquidity-zone and OI factors are reported
# as "данные недоступны" and never counted, so quality is capped at ~50%.
# Keeping this at 0.5 lets honest "ccxt-only" setups through; raise it later
# once a Coinglass key is added if you want to gate harder.
SIGNAL_MIN_QUALITY=0.5

# --- Coinglass (v4) — OPTIONAL ------------------------------------------------
# Powers the liquidation-heatmap and open-interest factors with REAL data.
# Leave EMPTY for now — we run without it. When empty, those two factors are
# shown as "данные недоступны", never counted as confirmations, and the engine
# honestly caps setup quality at ~50% (no fabricated confirmations).
SIGNAL_COINGLASS_API_KEY=

# --- PRIVATE Telegram channel -------------------------------------------------
# Distinct bot token + chat from the main bot. Get the token from @BotFather
# and the chat id from @userinfobot or the getUpdates call (see deploy steps).
# Binding name is SIGNAL_TELEGRAM_BOT_TOKEN (with _BOT_) — do not shorten it.
SIGNAL_TELEGRAM_BOT_TOKEN=
SIGNAL_TELEGRAM_CHAT_ID=

# --- Misc ---------------------------------------------------------------------
SIGNAL_LOG_LEVEL=INFO
